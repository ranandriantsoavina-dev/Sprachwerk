#:schema ../node_modules/wrangler/config-schema.json
name = "sprachwerk-academy"
main = "server.ts"
compatibility_date = "2026-01-01"
compatibility_flags = ["nodejs_compat"]

[alias]
"iconv-lite" = "./server/shims/iconv-lite.cjs"

[assets]
directory = "./dist"
binding = "ASSETS"
not_found_handling = "single-page-application"
run_worker_first = ["/api/*"]

[[d1_databases]]
binding = "DB"
database_name = "sprachwerk-db"
database_id = "YOUR_CLOUDFLARE_D1_DATABASE_ID"

[vars]
APP_URL = "https://sprachwerk.pages.dev"

# Secrets required for production deployment (configure via `wrangler secret put <KEY>`):
# - SESSION_SECRET: High-entropy secret string for signing and hardening session state
# - MAILTRAP_API_TOKEN: API token for Mailtrap email delivery
# - MAILTRAP_SENDER_EMAIL: Sender email address (e.g. noreply@sprachwerk.academy)
# - MAILTRAP_SANDBOX_INBOX_ID: Optional sandbox inbox ID for staging/testing delivery
# - ADMIN_PASSCODE: Optional passcode required for initial admin bootstrap
